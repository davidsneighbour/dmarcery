{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./node_modules/@dnbhq/biome-config/config.json"],
  "linter": {
    "rules": {
      "complexity": {
        // @dnbhq/tsconfig enables noPropertyAccessFromIndexSignature, which requires
        // bracket access (row["name"]) on index-signature types such as SQLite rows.
        // useLiteralKeys asks for the opposite (row.name), so the two rules conflict.
        // Remove when https://github.com/davidsneighbour/biome-config/issues/3 is released.
        "useLiteralKeys": "off"
      }
    }
  }
}
