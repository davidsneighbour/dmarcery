{
  "name": "dmarcery",
  "version": "0.1.0",
  "description": "Local, portable history of DMARC aggregate reports with an audit and anomaly-detection CLI.",
  "private": true,
  "type": "module",
  "bin": {
    "dmarc": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc -p tsconfig.check.json",
    "test": "node --test test/*.test.ts",
    "dmarc": "node src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "author": "Patrick Kollitsch",
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
