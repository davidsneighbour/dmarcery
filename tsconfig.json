{
  "extends": "@dnbhq/tsconfig/cli",
  "compilerOptions": {
    // The shared preset is type-check only (noEmit). This project builds the CLI into dist/.
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    // Source imports use .ts extensions so Node runs src/ directly; emit rewrites them to .js.
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"]
}
